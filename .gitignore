# Godot auto-generated files
*.gen.*
.godot/

# Native build outputs
/build/
/build_android/

# Ignore library files but keep extension descriptors and required platform binaries
/bin/**
!project/bin/*.gdextension
*.so
!project/bin/android/
!project/bin/android/*.so

# SCons and generated documentation
.sconsign*.dblite
custom.py
compile_commands.json
/src/gen

# Compiled binaries and intermediate files
*.o
*.os
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp
*.dll

# Android export artifacts and Gradle caches
*.apk
*.aab
*.idsig
/project/android/.gradle/
/project/android/build/.gradle/
/project/android/build/build/
/project/android/build/libs/debug/godot-lib.template_debug.aar
/project/android/build/libs/release/godot-lib.template_release.aar

# Other generated files
*.log
.DS_Store

# VSCode
.vscode/*
!.vscode/extensions.json

# JetBrains
.idea/

# CMake
cmake-build*
CMakeUserPresets.json

# Recursos generados al exportar la aplicación Android
/project/android/build/src/main/assets/

# Archivos temporales del editor
*.tmp
*.TMP