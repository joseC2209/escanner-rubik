; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Escáner Rubik"
run/main_scene="res://pantalla_carga.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.101960786, 0.16862746, 0.29803923, 1)
boot_splash/show_image=false
config/icon="res://iconos/logo_app.png"

[autoload]

Global="*res://Global.gd"
NavegacionGlobal="*uid://ckx3hm1tmaieo"

[display]

window/handheld/orientation=1

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/NativeCameraPlugin/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
